 101          // adc采集+滤波
 102          u16 adc_getval(void)
 103          {
 104   1          u16 adc_val_tmp = 0;     // 存放单次采集到的ad值
 105   1          u32 adc_val_sum = 0;     // 存放所有采集到的ad值的累加
 106   1          u16 get_adcmax = 0;      // 存放采集到的最大的ad值
 107   1          u16 get_adcmin = 0xFFFF; // 存放采集到的最小的ad值(初始值为最大值)
 108   1          u8 i = 0;
 109   1      
 110   1          for (i = 0; i < 20; i++)
 111   1          {
C51 COMPILER V9.60.7.0   ADC                                                               05/08/2026 18:48:32 PAGE 3   

 112   2              adc_val_tmp = adc_single_convert(); // 获取一次ad值
 113   2              if (i < 2)
 114   2                  continue; // 丢弃前两次采样的
 115   2              if (adc_val_tmp > get_adcmax)
 116   2                  get_adcmax = adc_val_tmp; // 更新当前采集到的最大值
 117   2              if (adc_val_tmp < get_adcmin)
 118   2                  get_adcmin = adc_val_tmp; // 更新当前采集到的最小值
 119   2              adc_val_sum += adc_val_tmp;
 120   2          }
 121   1      
 122   1          adc_val_sum -= get_adcmax;        // 去掉一个最大
 123   1          adc_val_sum -= get_adcmin;        // 去掉一个最小
 124   1          adc_val_tmp = (adc_val_sum >> 4); // 除以16，取平均值
 125   1      
 126   1          return adc_val_tmp;
 127   1      }
