  91          // 获取adc值，存放到变量adc_val中(adc单次转换)
  92          u16 adc_single_convert(void)
  93          {
  94   1          ADC_CFG0 |= ADC_CHAN0_TRG(0x1); // 触发ADC0转换
  95   1          while (!(ADC_STA & ADC_CHAN0_DONE(0x1)))
  96   1              ;                                           // 等待转换完成
  97   1          ADC_STA = ADC_CHAN0_DONE(0x1);                  // 清除ADC0转换完成标志位
  98   1          return ((ADC_DATAH0 << 4) | (ADC_DATAL0 >> 4)); // 读取ADC0的值
  99   1      }
