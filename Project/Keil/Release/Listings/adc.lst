 129          // 由定时器调用，adc通道切换
 130          void adc_channel_switch_by_isr(void)
 131          {
 132   1          switch (adc_channel_status)
 133   1          {
 134   2          case ADC_CHANNEL_STATUS_NONE:
 135   2          case ADC_CHANNEL_STATUS_SEL_FUEL_END:
 136   2              // 默认状态或者是已经采集完油量对应的ad值，转换到下一个通道
 137   2              adc_channel_set(ADC_CHANNEL_BATTERY);
 138   2              adc_channel_status = ADC_CHANNEL_STATUS_SEL_BATTERY_BEGIN;
 139   2              break;
 140   2          case ADC_CHANNEL_STATUS_SEL_BATTERY_BEGIN:
 141   2              ADC_CFG0 |= ADC_CHAN0_TRG(0x1); // 触发ADC0转换
 142   2              adc_channel_status = ADC_CHANNEL_STATUS_SEL_BATTERY_END;
 143   2              break;
 144   2          case ADC_CHANNEL_STATUS_SEL_BATTERY_END:
 145   2              adc_channel_set(ADC_CHANNEL_FUEL);
 146   2              adc_channel_status = ADC_CHANNEL_STATUS_SEL_FUEL_BEGIN;
 147   2              break;
 148   2          case ADC_CHANNEL_STATUS_SEL_FUEL_BEGIN:
 149   2              ADC_CFG0 |= ADC_CHAN0_TRG(0x1); // 触发ADC0转换
 150   2              adc_channel_status = ADC_CHANNEL_STATUS_SEL_FUEL_END;
 151   2              break;
 152   2      
 153   2          default:
 154   2              break;
 155   2          }
 156   1      }
