 239          void speed_scan(void)
 240          {
 241   1          volatile u32 cur_speed = 0;
 242   1          volatile u32 tmp = 0;
 243   1          // static u8 is_initiatlized = 0;
 244   1      
 245   1          if (cur_speed_scan_time >= SPEED_SCAN_UPDATE_TIME || flag_is_speed_scan_over_time)
 246   1          {
 247   2              /*
 248   2                  采集到的脉冲个数 / 一圈对应的脉冲个数 * 车轮一圈对应走过的距离（�
             -��位：mm），
 249   2                  计算得到 采集的脉冲个数对应走过的距离（单位：mm）
 250   2              */
 251   2              // u32 tmp = (cur_speed_scan_pulse * SPEED_SCAN_MM_PER_TURN / SPEED_SCAN_PULSE_PER_TURN);
 252   2              tmp = ((cur_speed_scan_pulse * SPEED_SCAN_MM_PER_TURN) / SPEED_SCAN_PULSE_PER_TURN);
 253   2      
 254   2              // 27,638 = (脉冲个数 * 1070) / 3;
 255   2              //             77
 256   2      
 257   2              // printf("cur_speed_scan_pulse %lu\n", cur_speed_scan_pulse);
 258   2      
 259   2              if (flag_is_speed_scan_over_time) // 超时，采集到的脉冲个数对应一直是0km/h，认�
             -�时速是0
 260   2              {
 261   3                  printf("scan over time\n");
 262   3                  if (cur_speed_scan_pulse != 0)
 263   3                  {
 264   4                      // 如果采集的脉冲个数不为0
 265   4                      cur_speed = 1;
 266   4                  }
 267   3                  else
 268   3                  {
 269   4                      cur_speed = 0;
 270   4                  }
 271   3              }
 272   2              else // 未超时，计算采集到的脉冲个数对应走过的距离，再转换成以 km/h 的
             -单位
 273   2              {
 274   3                  /*
 275   3                      采集的脉冲个数对应走过的距离（单位：mm）/ 采集所用的时间（单�
             -�：ms） == 速度（单位：mm/ms）
 276   3                      1mm/ms == 1m/s
 277   3                      因为 1mm/ms * 1000 == 1m/ms
 278   3                           1m/ms  / 1000 == 1m/s
 279   3                           先乘以1000再除以1000，那么这个操作就可以去掉，直接化简为 1mm/
             -ms == 1m/s
 280   3      
 281   3                      1m/s == 3.6km/h，那么根据得到的 以 m/s 为单位的速度，先乘以36再除以1
             -0，得到以km/h为单位的速度值
 282   3      
 283   3                      cur_speed == 采集的脉冲个数对应走过的距离（单位：mm）/ 采集所用的�
             -��间（单位：ms）* 3.6
 284   3                      换成单片机可以计算的格式：
 285   3                      cur_speed == 采集的脉冲个数对应走过的距离（单位：mm） * 36 / 10 / 采�
             -�所用的时间（单位：ms）
 286   3                  */
 287   3                  cur_speed = tmp * 36 / 10 / cur_speed_scan_time;
 288   3              }
 289   2      
 290   2              // 防止时速为0时（有可能是推车，记录不到速度），记录不到里程
