             -�时速是0
 263   2              {
 264   3                  // printf("scan over time\n");
 265   3                  if (cur_speed_scan_pulse != 0)
 266   3                  {
 267   4                      // 如果采集的脉冲个数不为0
 268   4                      cur_speed = 1;
 269   4                  }
 270   3                  else
 271   3                  {
 272   4                      cur_speed = 0;
 273   4                  }
 274   3              }
 275   2              else // 未超时，计算采集到的脉冲个数对应走过的距离，再转换成以 km/h 的
             -单位
 276   2              {
 277   3                  /*
 278   3                      采集的脉冲个数对应走过的距离（单位：mm）/ 采集所用的时间（单�
             -�：ms） == 速度（单位：mm/ms）
 279   3                      1mm/ms == 1m/s
 280   3                      因为 1mm/ms * 1000 == 1m/ms
