 242          void speed_scan(void)
 243          {
 244   1          volatile u32 cur_speed = 0;
 245   1          volatile u32 tmp = 0;
 246   1          // static u8 is_initiatlized = 0;
 247   1      
 248   1          if (cur_speed_scan_time >= SPEED_SCAN_UPDATE_TIME || flag_is_speed_scan_over_time)
 249   1          {
 250   2              /*
 251   2                  采集到的脉冲个数 / 一圈对应的脉冲个数 * 车轮一圈对应走过的距离（�
             -��位：mm），
 252   2                  计算得到 采集的脉冲个数对应走过的距离（单位：mm）
 253   2              */
 254   2              // u32 tmp = (cur_speed_scan_pulse * SPEED_SCAN_MM_PER_TURN / SPEED_SCAN_PULSE_PER_TURN);
 255   2              tmp = ((cur_speed_scan_pulse * SPEED_SCAN_MM_PER_TURN) / SPEED_SCAN_PULSE_PER_TURN);
 256   2      
 257   2              // 27,638 = (脉冲个数 * 1070) / 3;
 258   2              //             77
 259   2      
 260   2              // printf("cur_speed_scan_pulse %lu\n", cur_speed_scan_pulse);
 261   2      
