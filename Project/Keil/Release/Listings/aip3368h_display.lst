 614   2              {
 615   3                  animation_engine_speed_scale_bar_step = 0;
 616   3                  animation_engine_speed_scale_bar_phase = 2; // 进入递减阶段
 617   3              }
 618   2              // 保持显示最高级别
 619   2              // aip3368h_display_engine_speed_scale_bar(12);
 620   2          }
 621   1          else if (animation_engine_speed_scale_bar_phase == 2)
 622   1          {
