 373   1          // 显示里程的数值，不包括单位、小数点：
 374   1          for (i = 0; i < 6; i++)
 375   1          {
 376   2              __aip3368h_display_mileage_bit_x__(5 - i, mileage % 10);
 377   2              mileage /= 10;
 378   2          }
 379   1      }
