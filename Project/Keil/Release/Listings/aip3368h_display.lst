 321          /**
 322           * @brief 里程显示中，在第 x 位显示数字
 323           *
 324           * @attention 是 aip3368h_display_mileage() 的子函数
 325           *
 326           * @param bit_x 0 ~ 5 (0=个位, 5=十万位)
 327           * @param number 0 ~ 9
 328           */
 329          void __aip3368h_display_mileage_bit_x__(u8 bit_x, u8 number)
 330          {
 331   1          u8 i;
 332   1          // u8 j; // 循环计数值
 333   1          // 参数有效性检查（为了节省程序空间，这里可以省略）
 334   1          // if (bit_x > 5 || number > 9)
 335   1          // {
 336   1          //     return;
 337   1          // }
 338   1      
 339   1          // 获取该数字对应的7段码 (要显示的数字 --> 七段码)
 340   1          u8 segment_code = digit_segment_code[number];
 341   1      
 342   1          // 清除 bit_x 对应数码管 a ~ g 段的显示
 343   1          for (i = 0; i < 7; i++) //
 344   1          {
 345   2              aip3368h_display_buff[mileage_segment_map[bit_x][i].buff_index] &=
 346   2                  ~(0x01 << mileage_segment_map[bit_x][i].bit_offset);
 347   2      
 348   2              // 检查该段是否需要点亮 (segment_code的对应bit是否为1)
 349   2              if (segment_code & (1 << i))
 350   2              {
 351   3                  // 点亮该段
 352   3                  aip3368h_display_buff[mileage_segment_map[bit_x][i].buff_index] |=
 353   3                      (0x01 << mileage_segment_map[bit_x][i].bit_offset);
 354   3              }
 355   2          }
 356   1      }
