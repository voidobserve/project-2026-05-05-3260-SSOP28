 321          /**
 322           * @brief 里程显示中，在第 x 位显示数字
 323           *
 324           * @attention 是 aip3368h_display_mileage() 的子函数
 325           *
 326           * @param bit_x 0 ~ 5 (0=个位, 5=十万位)
 327           * @param number 0 ~ 9
 328           */
 329          static void __aip3368h_display_mileage_bit_x__(u8 bit_x, u8 number)
 330          {
 331   1          u8 seg;
 332   1          // 参数有效性检查（为了节省程序空间，这里可以省略）
 333   1          // if (bit_x > 5 || number > 9)
 334   1          // {
 335   1          //     return;
 336   1          // }
 337   1      
 338   1          // 获取该数字对应的7段码 (要显示的数字 --> 七段码)
 339   1          u8 segment_code = digit_segment_code[number];
 340   1      
 341   1          // 根据段码设置对应的buff位
 342   1          for (seg = 0; seg < 7; seg++)
 343   1          {
 344   2              // 检查该段是否需要点亮 (segment_code的对应bit是否为1)
 345   2              if (segment_code & (1 << seg))
 346   2              {
 347   3                  // 点亮该段
 348   3                  aip3368h_display_buff[mileage_segment_map[bit_x][seg].buff_index] |=
 349   3                      (0x01 << mileage_segment_map[bit_x][seg].bit_offset);
 350   3              }
 351   2          }
 352   1      }
