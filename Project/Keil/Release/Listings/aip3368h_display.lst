 357           * @param mileage
 358           */
 359          void __aip3368h_display_mileage__(u32 mileage)
 360          {
 361   1          u8 i; // 循环计数值
 362   1          u8 j; // 循环计数值
 363   1          // 清除第 0 ~ 5 位数码管的显示
 364   1          for (i = 0; i < 6; i++)
 365   1          {
 366   2              for (j = 0; j < 7; j++) // 第 i 位数码管的 a ~ g 段
 367   2              {
 368   3                  aip3368h_display_buff[mileage_segment_map[i][j].buff_index] &=
 369   3                      ~(0x01 << mileage_segment_map[i][j].bit_offset);
 370   3              }
 371   2          }
