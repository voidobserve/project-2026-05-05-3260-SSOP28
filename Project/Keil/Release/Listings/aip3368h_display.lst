 593   1          // 阶段3 (最后时段): 从高到低递减
 594   1          animation_engine_speed_scale_bar_step++;
 595   1      
 596   1          if (animation_engine_speed_scale_bar_phase == 0)
 597   1          {
 598   2              // 阶段1: 递增阶段
