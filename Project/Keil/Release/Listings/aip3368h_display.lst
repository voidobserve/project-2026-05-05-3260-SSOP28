 458   1          // 根据段码设置对应的buff位
 459   1          for (i = 0; i < 7; i++)
 460   1          {
 461   2              // 检查该段是否需要点亮 (segment_code的对应bit是否为1)
 462   2              if (segment_code & (1 << i))
 463   2              {
 464   3                  // 点亮该段
 465   3                  aip3368h_display_buff[speed_segment_map[bit_x][i].buff_index] |=
 466   3                      (0x01 << speed_segment_map[bit_x][i].bit_offset);
 467   3              }
 468   2          }
 469   1      }
