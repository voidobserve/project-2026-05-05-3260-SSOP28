 181              0x5B, // 2: abdeg
 182              0x4F, // 3: abcdg
 183              0x66, // 4: bcfg
 184              0x6D, // 5: acdfg
 185              0x7D, // 6: acdefg
 186              0x07, // 7: abc
 187              0x7F, // 8: abcdefg
 188              0x6F  // 9: abcdfg
 189          };
