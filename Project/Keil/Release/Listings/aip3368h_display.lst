 608   4                      animation_engine_speed_scale_bar_step = 0;
 609   4                  }
 610   3      
 611   3                  aip3368h_display_engine_speed_scale_bar(animation_engine_speed_scale_bar_level);
 612   3              }
 613   2          }
 614   1          else if (animation_engine_speed_scale_bar_phase == 1)
 615   1          {
 616   2              // 阶段2: 保持最高阶段
 617   2              // 假设保持时间为 xx ms (可根据需要调整)
 618   2              if (animation_engine_speed_scale_bar_step >= 200)
 619   2              {
 620   3                  animation_engine_speed_scale_bar_step = 0;
 621   3                  animation_engine_speed_scale_bar_phase = 2; // 进入递减阶段
 622   3              }
 623   2              // 保持显示最高级别
