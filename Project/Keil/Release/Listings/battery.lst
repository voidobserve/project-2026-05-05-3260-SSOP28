  14          /**
  15           * @brief 将ad值转换为对应的电压值
  16           *
  17           * @param arg_adc_val 采集到的ad值
  18           * @return u8 计算好的电压值，单位0.1V
  19           */
  20          u16 conver_adc_val_to_voltage(u16 arg_adc_val)
  21          {
  22   1          /*
  23   1              采集到的ad值范围：0~4095
  24   1              ad值对应的电压： 0 ~ MAX_VOLTAGE_OF_BATTERY
  25   1              那么 每单位ad值对应 MAX_VOLTAGE_OF_BATTERY / 4096
  26   1          */
  27   1          // return (u32)arg_adc_val * MAX_VOLTAGE_OF_BATTERY / 4096;
  28   1      
  29   1          // 使用2.4V参考电压，12位精度（0 ~ 4095）
  30   1          // 电池电压 1/11 分压：
  31   1          return (u32)arg_adc_val * 240 * 11 / 10 / 4096;
  32   1      }
  33          
  34          // 将电池电压转换为对应的百分比
  35          // voltage： 0~255 ， 对应0~25.5V
  36          // 例如 voltage == 140，对应14.0V
  37          u8 conver_voltage_of_battery_to_percentage(u8 voltage)
  38          {
  39   1          u8 tmp;
  40   1      
  41   1          // 客户要求，如果检测到大于15V，就认为满电
  42   1          if (voltage >= 150)
  43   1          {
  44   2              tmp = 100;
  45   2          }
  46   1          else
  47   1          {
  48   2              // 如果电压小于15V，根据公式来得到百分比
  49   2              // 用电池电压voltage除以MAX_VOLTAGE_OF_BATTERY，得到占比，再乘以100，得到百分
             -比
  50   2              tmp = (u16)voltage * 100 / MAX_VOLTAGE_OF_BATTERY;
  51   2          }
  52   1      
C51 COMPILER V9.60.7.0   BATTERY                                                           05/08/2026 18:48:33 PAGE 2   

  53   1          return tmp;
  54   1      }
